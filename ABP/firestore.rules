rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // STEP: replace PASTE_ADMIN_UID_HERE with the owner's User UID
    // (Firebase console -> Authentication -> Users -> copy "User UID")
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID_HERE';
    }

    // Public list of taken time slots. Holds only a date and a time, no personal data.
    // A slot can only be created once, so two people can never book the same slot.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'time'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2} (AM|PM)$')
        && slotId == request.resource.data.date + '_'
             + request.resource.data.time.replace(':', '').replace(' ', '');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Customer details. Anyone can create a booking, only the owner can see or change them.
    match /bookings/{bookingId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'phone', 'service', 'date', 'time', 'notes', 'status', 'slotId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 70
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.service is string
        && request.resource.data.service.size() <= 60
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2} (AM|PM)$')
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.status == 'Booked'
        && request.resource.data.createdAt == request.time
        && request.resource.data.slotId == request.resource.data.date + '_'
             + request.resource.data.time.replace(':', '').replace(' ', '')
        // the slot must be created in the same write, and must not exist already
        && !exists(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
        && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId));
    }
  }
}
